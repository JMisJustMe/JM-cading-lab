<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- Only opt-in JM widget QA packages; no QUERY_ALL_PACKAGES permission. -->
    <queries>
        <package android:name="com.jmisjustme.foldultra.widgetqa"/>
        <package android:name="com.jmisjustme.foldultra.widgetv2qa"/>
        <package android:name="com.jmisjustme.foldultra.widgetv3qa"/>
    </queries>
    <application android:label="JM OS Home · Candidate" tools:replace="android:label">
        <!-- Reject inherited external routes and app launcher on the QA-only main activity. -->
        <activity android:name="com.jmisjustme.foldultra.MainActivity"
                  android:exported="false" tools:node="replace"/>
        <activity android:name="com.jmisjustme.foldultra.oshome.JMOsHomeActivity"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
