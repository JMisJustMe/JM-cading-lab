<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <!-- Least-scope visibility for native owner-tapped app drawer. -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.samsung.android.app.notes" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.sec.android.gallery3d" />
        <!-- Only individual packages used by explicit owner-tapped JM app launches. -->
        <package android:name="com.jmisjustme.foldultra" />
        <package android:name="com.jmisjustme.foldultra.homelabqa" />
        <package android:name="com.jmisjustme.ailatheocreation" />
        <package android:name="org.jmecostate.slingfall.cp08" />
        <package android:name="com.jmisjustme.rimroute" />
        <package android:name="com.jm.theocnative.deviceapp" />
        <package android:name="com.aistudio.jmecostate.kvxp.qa" />
        <package android:name="com.jmisjustme.commanderbridge" />
        <package android:name="com.jmisjustme.cp03sandboxproof" />
    </queries>
    <application android:allowBackup="false"
        android:label="JM Fold Ultra"
        android:icon="@drawable/jm_root_mark"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/JMOpeningTheme">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|orientation"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Selected images/PDFs require user Share and explicit in-app approval. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Public, navigation-only deep link; no privileged device or JM state operation. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/galaxy" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/projects" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/continue" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/capture" />
            </intent-filter>
            <!-- Official Android static shortcut; same allowlisted GALAXY route. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Opt-in preview: no HOME intent filter, exported=false, no permission changes. -->
        <!-- Searchable original-creation access; never Android HOME. -->
        <activity android:name=".creations.CreationsActivity" android:exported="false" />
        <activity android:name=".launcher.LauncherLabActivity" android:exported="false" />
        <activity android:name=".workroom.WorkroomActivity" android:exported="false"
            android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
