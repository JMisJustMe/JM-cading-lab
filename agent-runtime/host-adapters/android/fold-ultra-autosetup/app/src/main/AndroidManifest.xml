<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.samsung.android.app.notes" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.sec.android.gallery3d" />
    </queries>
    <application android:allowBackup="false"
        android:label="JM Fold Ultra"
        android:icon="@drawable/jm_root_mark"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/JMOpeningTheme">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|orientation"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Public, navigation-only deep link; no privileged device or JM state operation. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/galaxy" />
            </intent-filter>
            <!-- Public allowlisted Contact 003 navigation endpoints, each exact-path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/root" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/projects" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/games" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/music" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/sessions" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jmfoldultra" android:host="open" android:path="/recovery" />
            </intent-filter>
            <!-- Official Android static shortcut; same allowlisted GALAXY route. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
