<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="17dp" android:background="@drawable/jm_widget_background" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/jm_widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="43dp" android:gravity="center_vertical" android:text="JM / FOLD ULTRA • V3" android:textStyle="bold" android:textSize="18sp" android:textColor="#F3E9FF"/>
  <TextView android:id="@+id/jm_widget_refresh" android:layout_width="65dp" android:layout_height="43dp" android:gravity="center" android:text="Refresh ↻" android:textSize="12sp" android:textColor="#E9BD80"/>
 </LinearLayout>
 <TextView android:id="@+id/jm_widget_filter" android:layout_width="match_parent" android:layout_height="45dp" android:gravity="center_vertical" android:text="ALL ▾" android:textSize="16sp" android:textColor="#D9B1FF"/>
 <TextView android:id="@+id/jm_widget_selected" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="JM Ecostate" android:textStyle="bold" android:textSize="23sp" android:textColor="#FFFFFF"/>
 <TextView android:id="@+id/jm_widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ESTATE • 1/9" android:textSize="13sp" android:textColor="#E9BD80"/>
 <TextView android:id="@+id/jm_widget_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="9 projects" android:textSize="12sp" android:textColor="#B8B1C6"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/jm_widget_prev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="‹ Previous" android:textColor="#FFFFFF" android:textSize="15sp"/>
  <TextView android:id="@+id/jm_widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="Next ›" android:textColor="#FFFFFF" android:textSize="15sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/jm_widget_continue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" android:text="Resume ↗" android:textColor="#E9BD80" android:textSize="14sp"/>
  <TextView android:id="@+id/jm_widget_projects" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" android:text="Shelf ↗" android:textColor="#FFFFFF" android:textSize="14sp"/>
  <TextView android:id="@+id/jm_widget_capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" android:text="Capture ↗" android:textColor="#FFFFFF" android:textSize="14sp"/>
  <TextView android:id="@+id/jm_widget_galaxy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" android:text="Galaxy ↗" android:textColor="#FFFFFF" android:textSize="14sp"/>
 </LinearLayout>
</LinearLayout>