# JM INTERTAP // HTML ROUTER v0.1.4
# Human-originated, human-governed, AI-assisted.
module com.jmisjustme.intertaproute
family: JM INTERTAP HTML ROUTER
version: 0.1.4

body Cading
body Kading
body JMLogic
body FlowTalk
body RouteCode
body Quadze
body OneBody IR
body CadenVM
body CodeHand
body RouteOS
body TraceBox
body THEO
body Build Gates
body Zionfolder

android:
  package: com.jmisjustme.intertaproute
  appName: JM INTERTAP Router
  artifactName: JM_INTERTAP_HTML_ROUTER
  versionName: 0.1.4
  versionCode: 14
  minSdk: 26
  targetSdk: 35
  compileSdk: 35
  permissions: android.permission.INTERNET
  carrierDonor: JM Estate Compass v1.2.2 clean Android host
  browserDonor: JM Browser Child / GUT lived child route
  asset: assets/index.html
end

flow build:
  step recoverEstateDonors
  step sourceGate
  step stableHttpsLocalOrigin
  step fileChooserContact
  step htmlLinkIntake
  step contactClassify
  step routePreserve
  step androidOpenFirst
  step capabilityFallback
  step traceReceipt
  step recoveryExport
  goto receipt
end

func intertapRoute(source, body, host):
  do preserve original source reference
  do classify source protocol before open claim
  do bind local HTML without collapsing source identity
  do use Android Storage Access Framework for chosen HTML and JSON files
  do keep imported preview bodies sandboxed from parent origin
  do adapt trusted embedded donor descendants to sandbox limits instead of weakening the parent sandbox
  do authorise native bridge calls with a per-launch nonce
  do open web routes through Android ACTION_VIEW
  do fall back from localStorage to IndexedDB to export
  expect source and destination remain separately traceable
  emit TraceBox receipt
  return openable route or bounded HOLD
end

map JM Estate Compass v1.2.2 -> WebChromeClient file chooser + stable local host
map JM GUT Convergence Engine v0.2 -> lived unique child install floor
map JM Browser Child v4 -> lean browser APK route
map URL Receiver -> INTERTAP Intake
map DoorDock -> Route Registry
map URL Route Room Launcher 006.1 -> Open Surface
map Tunneledoor Android Safe Launcher -> Android Open-First
map JM Singular Link MultiHub Registry -> Embedded Recovered Body descendant with sandbox-safe memory/export fallback
map Device Continuity -> Capability Fallback Laws

state CLEAN_GRADLE_BUILD_ROUTE_CI_PASS
boundary no static build proof becomes owner-device Ding
boundary file/content/sandbox references are preserved until Android grants an explicit intake route
ding JM-authority-after-real-device-contact
