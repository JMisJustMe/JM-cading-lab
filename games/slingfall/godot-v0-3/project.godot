; SLINGFALL v0.3 LIVING BATTLEFIELD — inherits v0.2 independent native Godot 4 branch.
; Keep v0.2 config/name to preserve existing Godot user:// save directory.
; Original web build byte-preserved in ancestry/.
config_version=5

[application]
config/name="SLINGFALL — Field Ascent"
run/main_scene="res://Main.tscn"
config/description="JM SLINGFALL: inherited native flinging and three contested zones; distinctive signature combat, tactical terrain and living weather."

[display]
window/size/viewport_width=1200
window/size/viewport_height=700
window/size/window_width_override=1200
window/size/window_height_override=700
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0313725, 0.0705882, 0.0862745, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60
