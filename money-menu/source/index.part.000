<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#090d16">
<meta name="description" content="JM Money Menu public contact carrier: 242 governed commercial routes with shortlist, enquiry, brief, scope and receipt handoff.">
<title>JM Money Menu — Public Contact Carrier v1.2</title>
<style>
:root{--bg:#070a10;--panel:#101724;--panel2:#151e2e;--line:#2b3850;--text:#f7f9fd;--muted:#aab6ca;--gold:#ffd166;--mint:#77e8bd;--blue:#83c8ff;--red:#ff8e99;--r:18px}
*{box-sizing:border-box;min-width:0}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 15% -5%,#253453 0,transparent 34%),var(--bg);color:var(--text);font:15px/1.5 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
button,input,select{font:inherit}button{cursor:pointer}.shell{width:min(1450px,calc(100% - 24px));margin:auto;padding-bottom:90px}
header{position:sticky;top:0;z-index:30;background:rgba(7,10,16,.9);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.08)}.bar{width:min(1450px,calc(100% - 24px));margin:auto;display:flex;gap:10px;align-items:center;padding:calc(10px + env(safe-area-inset-top)) 0 10px}.mark{width:46px;height:46px;display:grid;place-items:center;border-radius:15px;background:var(--gold);color:#17120a;font-weight:1000}h1{font-size:1.05rem;margin:0}.sub{font-size:.75rem;color:var(--muted)}.actions{margin-left:auto;display:flex;gap:7px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:#1a2435;color:var(--text);border-radius:12px;padding:10px 12px;font-weight:900}.btn.primary{background:var(--gold);color:#17120a;border-color:transparent}
.hero{display:grid;grid-template-columns:1.3fr .7fr;gap:12px;padding:18px 0 12px}.hero>div,.panel{background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));border:1px solid var(--line);border-radius:var(--r)}.heroMain{padding:24px}.eyebrow{color:var(--mint);font-size:.72rem;font-weight:1000;letter-spacing:.14em;text-transform:uppercase}.hero h2{font-size:clamp(2.7rem,8vw,6.2rem);line-height:.88;letter-spacing:-.065em;margin:.18em 0 .22em}.hero h2 span{color:var(--gold)}.hero p{color:var(--muted);max-width:78ch}.law{display:inline-block;margin-top:12px;padding:11px 13px;border-left:4px solid var(--gold);background:rgba(255,209,102,.08);font-weight:900}.stats{padding:14px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.stat{padding:13px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.stat b{display:block;font-size:1.65rem;color:var(--mint)}.stat span{font-size:.72rem;color:var(--muted)}
.proof{padding:14px;margin-bottom:12px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.proof div{background:rgba(255,255,255,.035);border:1px solid var(--line);border-radius:12px;padding:11px}.proof b{display:block;color:var(--gold)}.proof span{font-size:.72rem;color:var(--muted)}
.controls{display:grid;grid-template-columns:minmax(220px,1.5fr) repeat(3,minmax(130px,.5fr));gap:8px;margin-bottom:12px}input,select{width:100%;background:#0c121d;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px}input:focus,select:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(255,209,102,.12)}
.statusline{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:10px 0;color:var(--muted)}.statusline b{color:var(--text)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:15px;display:flex;flex-direction:column;min-height:245px}.card.selected{border-color:var(--gold);box-shadow:inset 0 0 0 1px rgba(255,209,102,.16)}.top{display:flex;gap:8px;align-items:start}.top h3{margin:0;font-size:1.06rem;line-height:1.18;flex:1}.pill{font-size:.67rem;border:1px solid var(--line);border-radius:999px;padding:4px 7px;color:var(--muted);white-space:nowrap}.meta{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.tag{font-size:.7rem;padding:5px 7px;border-radius:8px;background:#202b3f;color:#dfe7f5}.price{color:var(--gold)}.card p{color:var(--muted);margin:.1em 0 12px}.boundary{font-size:.76rem;border-top:1px solid var(--line);padding-top:10px;margin-top:auto;color:#ccd7e8}.card .btn{width:100%;margin-top:10px}
.empty{grid-column:1/-1;padding:44px;text-align:center;border:1px dashed var(--line);border-radius:16px;color:var(--muted)}dialog{width:min(760px,calc(100vw - 22px));max-height:88dvh;overflow:auto;border:1px solid var(--line);border-radius:20px;background:#0d1420;color:var(--text);padding:0;box-shadow:0 30px 90px #000}dialog::backdrop{background:rgba(0,0,0,.75)}.dlgHead{position:sticky;top:0;display:flex;gap:10px;align-items:center;padding:14px;background:#0d1420;border-bottom:1px solid var(--line)}.dlgHead h2{margin:0;flex:1;font-size:1.15rem}.dlgBody{padding:16px}.receipt{white-space:pre-wrap;background:#080d15;border:1px solid var(--line);border-radius:14px;padding:14px;color:#dce6f5}footer{margin-top:20px;text-align:center;color:var(--muted);font-size:.75rem}
@media(max-width:980px){.grid{grid-template-columns:repeat(2,1fr)}.hero{grid-template-columns:1fr}.controls{grid-template-columns:1fr 1fr}.controls input{grid-column:1/-1}}
@media(max-width:650px){.shell,.bar{width:min(100% - 16px,1450px)}.actions .label{display:none}.heroMain{padding:18px}.hero h2{font-size:3.5rem}.stats{grid-template-columns:repeat(4,1fr);padding:8px}.stat{padding:8px}.stat b{font-size:1.15rem}.stat span{font-size:.57rem}.proof{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}.card{min-height:0}}

.contact-law{display:block;margin-top:8px;padding:10px 12px;border-left:4px solid var(--mint);background:rgba(119,232,189,.07);font-size:.78rem;font-weight:850;color:#dffbf1}.front-window{margin-bottom:12px;padding:16px}.front-window-head{display:flex;align-items:end;justify-content:space-between;gap:12px;flex-wrap:wrap}.front-window h2{margin:0;font-size:1.35rem}.front-window p{margin:.25rem 0 0;color:var(--muted)}.offer-row{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:12px}.offer{border:1px solid var(--line);background:#0d1420;color:var(--text);border-radius:13px;padding:11px;text-align:left}.offer b{display:block;line-height:1.15}.offer span{display:block;color:var(--gold);font-size:.78rem;margin-top:5px}.offer:hover,.offer:focus-visible{border-color:var(--gold);outline:none}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid label{font-size:.75rem;font-weight:900;color:var(--muted)}.form-grid input,.form-grid select,.form-grid textarea{margin-top:5px}.form-grid .wide{grid-column:1/-1}.form-grid textarea{width:100%;min-height:100px;resize:vertical;background:#0c121d;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px}.scope-box{margin-top:12px}.scope-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.selec