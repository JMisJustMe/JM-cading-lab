";
async function decodePayload(){
  const raw=Uint8Array.from(atob(PAYLOAD),c=>c.charCodeAt(0));
  const stream=new Blob([raw]).stream().pipeThrough(new DecompressionStream('gzip'));
  return JSON.parse(await new Response(stream).text());
}
(async()=>{
const ROUTES=await decodePayload();
const META={"source_sha256": "1e96bd6884ab58ac4e8e6e0948293b965a5e5d505ca2b1068bc912956639aeea", "payload_sha256": "1ceaf2fbb93915fb163de7288e6d2f0df503cab577580dade872180390850a73"};
const selected=new Set();
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const houses=[...new Set(ROUTES.map(x=>x.house))].sort();
const states=[...new Set(ROUTES.map(x=>x.state))].sort();
houses.forEach(x=>$('#house').insertAdjacentHTML('beforeend',`<option>${esc(x)}</option>`));
states.forEach(x=>$('#state').insertAdjacentHTML('beforeend',`<option>${esc(x)}</option>`));
function current(){
 const q=$('#search').value.trim().toLowerCase(),h=$('#house').value,st=$('#state').value;
 let a=ROUTES.filter(x=>(!h||x.house===h)&&(!st||x.state===st)&&(!q||[x.id,x.title,x.house,x.state,x.price,x.tagline,x.source_status,x.boundary].join(' ').toLowerCase().includes(q)));
 const s=$('#sort').value;if(s!=='source')a.sort((a,b)=>String(a[s]).localeCompare(String(b[s])));
 return a;
}
function render(){
 const a=current();$('#shown').textContent=a.length;$('#selected').textContent=selected.size;
 $('#grid').innerHTML=a.length?a.map(x=>`<article class="card ${selected.has(x.id)?'selected':''}"><div class="top"><h3>${esc(x.title)}</h3><span class="pill">${esc(x.state)}</span></div><div class="meta"><span class="tag">${esc(x.house)}</span><span class="tag price">${esc(x.price)}</span><span class="tag">${esc(x.wave||'source')}</span></div><p>${esc(x.tagline)}</p><div class="boundary"><b>Boundary:</b> ${esc(x.boundary)}<br><b>Source:</b> ${esc(x.source_status)}</div><button class="btn" data-id="${esc(x.id)}">${selected.has(x.id)?'Remove from shortlist':'Add to shortlist'}</button></article>`).join(''):'<div class="empty">No routes meet this filter.</div>';
 document.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>{selected.has(b.dataset.id)?selected.delete(b.dataset.id):selected.add(b.dataset.id);render()});
}
['search','house','state','sort'].forEach(id=>$('#'+id).addEventListener(id==='search'?'input':'change',render));
$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({title:'JM Money Menu — Public Contact Carrier v1.2',routes:ROUTES,shortlist:[...selected],meta:META},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='JM_MONEY_MENU_PUBLIC_CONTACT_CARRIER_v1_2_export.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
const FEATURED_IDS=['jm-route-to-body','project-rescue-re-entry-session','mobile-ux-repair','pwa-packaging','digital-catalogue-showroom'];
const featured=FEATURED_IDS.map(id=>ROUTES.find(r=>r.id===id)).filter(Boolean);
$('#frontOffers').innerHTML=featured.map(x=>`<button class="offer" type="button" data-featured-id="${esc(x.id)}"><b>${esc(x.title)}</b><span>${esc(x.price)}</span></button>`).join('');
document.querySelectorAll('[data-featured-id]').forEach(b=>b.onclick=()=>{selected.add(b.dataset.featuredId);render();openEnquiry()});
let scopePack=null;
const contactTarget='jayemmlyrikz@gmail.com';
function selectedRoutes(){return [...selected].map(id=>ROUTES.find(r=>r.id===id)).filter(Boolean)}
function renderEnquirySelected(){const a=selectedRoutes();$('#enquirySelected').innerHTML=a.length?a.map(x=>`<div class="selected-line"><span><b>${esc(x.title)}</b><small>${esc(x.house)} · ${esc(x.state)} · ${esc(x.id)}</small></span><strong class="price">${esc(x.price)}</strong></div>`).join(''):'<div class="notice">No route is shortlisted yet. Close this dialog and choose one or more offers.</div>'}
function openEnquiry(){renderEnquirySelected();$('#enquiryDlg').showMod